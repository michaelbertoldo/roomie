# Roomie server configuration
#
# Local development: copy this file to .env.local (git-ignored).
# Vercel: add the same values in Project Settings > Environment Variables.
# Everything here is server-only. Never use a VITE_ prefix or expose these values in frontend code.

# --- Neon database and authentication ---

# Pooled Neon connection used by the API functions.
DATABASE_URL=
# Direct, non-pooled Neon connection used by migrations and drizzle-kit.
DATABASE_URL_UNPOOLED=
# Neon Auth base URL used to verify sign-in tokens against its JWKS.
NEON_AUTH_URL=

# Use `dev` with the Neon development branch and `main` only for production.
# Security and migration scripts verify this value against the actual database endpoint.
ROOMIE_DB_BRANCH=dev

# --- Application and scheduled jobs ---

# Public URL used in confirmation, event, and unsubscribe links. Do not include a trailing slash.
# Preview example: https://your-roomie-preview.vercel.app
APP_ORIGIN=

# Optional local API port. The default is 3001.
PORT=3001

# Enables authenticated Vercel Cron jobs. Generate 32+ random characters; leave blank to disable cron.
CRON_SECRET=

# --- Event email delivery with Brevo ---

# Keep disabled until migration 0004 is applied, the Brevo sender is verified, and Preview variables are configured.
EVENT_EMAIL_ENABLED=0

# Server-only key from Brevo > SMTP & API > API Keys. Never commit a real key.
BREVO_API_KEY=

# Must exactly match a sender registered and verified in Brevo.
# In a local .env file, quotes allow the display name and angle brackets. In Vercel, enter it without quotes.
EMAIL_FROM="Roomie <your.verified.address@gmail.com>"

# Signs unsubscribe links. Rotating it expires outstanding links.
# Generate with: openssl rand -base64 32
EMAIL_LINK_SECRET=

# HMAC key for notification-address hashes and confirmation-send rate limits.
# Generate separately with: openssl rand -base64 32
NOTIFICATION_HASH_SECRET=

# Optional Brevo test/mock endpoint. Leave blank in Preview and Production.
BREVO_BASE_URL=

# --- AI features ---

# Feature flags are independent. A configured API key does not enable a feature by itself.
HOME_AI_ENABLED=0
RECAP_AI_ENABLED=0
ONBOARDING_AI_ENABLED=0
EVENT_EMAIL_AI_ENABLED=0

# Preferred provider for this project. Set both values to use OpenRouter.
OPENROUTER_API_KEY=
# Exact OpenRouter model ID from your account/model catalog.
OPENROUTER_MODEL=

# Optional per-feature model overrides. Leave blank to use OPENROUTER_MODEL or AI_MODEL.
HOME_AI_MODEL=
RECAP_AI_MODEL=
ONBOARDING_AI_MODEL=
EVENT_EMAIL_AI_MODEL=
AI_MODEL=

# Optional alternative provider. Leave blank when using OpenRouter.
ANTHROPIC_API_KEY=

# Test/mock endpoints only. Leave blank in Preview and Production.
OPENROUTER_BASE_URL=
ANTHROPIC_BASE_URL=

