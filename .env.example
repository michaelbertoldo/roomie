# Copy to .env.local (git-ignored). Everything here is SERVER ONLY: read by /api functions and scripts.
# Never import these in frontend code and never give them a VITE_ prefix.

# Pooled Neon URL, table-owner role. Used by the /api functions.
DATABASE_URL=
# Direct (non-pooled) Neon URL. Used by drizzle-kit and migrations.
DATABASE_URL_UNPOOLED=
# Neon Auth base URL. /api verifies sign-in tokens against its JWKS.
NEON_AUTH_URL=

# Which Neon branch this file's URLs belong to. `dev` in .env.local, `main` in .env.production.local.
# Test scripts refuse to run unless this is dev AND the database itself reports the dev endpoint.
ROOMIE_DB_BRANCH=dev

# Shared secret for scheduled jobs (Vercel Cron sends it as a Bearer token). 32+ random characters. Unset = the cron endpoint is disabled.
CRON_SECRET=
