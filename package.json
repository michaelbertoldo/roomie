{
  "name": "roomie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx --env-file=.env.local scripts/dev-server.ts",
    "db:pull": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs pull && tsx scripts/sync-schema.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:unseed": "tsx --env-file=.env.local scripts/unseed.ts",
    "test": "vitest run",
    "test:security": "tsx --env-file=.env.local scripts/security-tests.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:preview": "tsx --env-file=.env.local scripts/preview-test.ts",
    "test:cleanup": "tsx --env-file=.env.local scripts/cleanup-tests.ts",
    "test:seed": "tsx --env-file=.env.local scripts/seed-test.ts",
    "db:seed:prod": "tsx --env-file=.env.production.local scripts/seed.ts --production",
    "db:unseed:prod": "tsx --env-file=.env.production.local scripts/unseed.ts --production",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.production.local scripts/migrate.ts --production"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
